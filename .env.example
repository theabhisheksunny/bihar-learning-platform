# ---------------------------------------------------------------------------
# Bihar Class IX Student Learning Platform - environment template
# Copy to `.env` for docker-compose, or export in your shell for local runs.
# NEVER commit real secrets. Override every default marked (CHANGE IN PROD).
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
DB_NAME=bihar_learning
DB_USERNAME=bihar
DB_PASSWORD=bihar                 # (CHANGE IN PROD)
# Used by the backend directly (compose sets this to the postgres service):
DB_URL=jdbc:postgresql://localhost:5432/bihar_learning

# --- Redis cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TYPE=redis                  # set to 'simple' to run without Redis
CACHE_TTL_SECONDS=600

# --- Backend server ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Security ---
# Base64-encoded 256-bit secret for signing JWTs (CHANGE IN PROD).
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9uLTEyMzQ1Ng==
JWT_EXPIRY_MINUTES=120
# Bootstrap admin created on first run (CHANGE IN PROD).
ADMIN_EMAIL=admin@bihar-learning.local
ADMIN_PASSWORD=admin12345

# --- Content sync (DISABLED by default; see docs/content-policy.md) ---
# Only enable after confirming each source's robots.txt and terms of use.
SYNC_ENABLED=false
SYNC_RATE_LIMIT_MS=3000
SYNC_REQUEST_TIMEOUT_MS=15000

# --- AI learning aids (off by default) ---
AI_ENABLED=false

# --- Frontend ---
BACKEND_URL=http://localhost:8080
SITE_URL=http://localhost:3000
